{
  "name": "api-spec",
  "version": "1.0.0",
  "main": "index.js",
  "license": "MIT",
  "scripts": {
    "build": "tsp compile . --emit @typespec/openapi3",
    "watch": "tsp compile . --emit @typespec/openapi3 --watch",
    "lint": "tsp format --check .",
    "api:lint": "spectral lint openapi.yaml",
    "api:preview": "swagger-ui-watcher tsp-output/@typespec/openapi3/openapi.yaml --port 8080",
    "dev": "concurrently -n TSP,UI -c auto \"yarn watch\" \"yarn api:preview\""
  },
  "devDependencies": {
    "@stoplight/spectral-cli": "^6.15.0",
    "@typespec/compiler": "^1.5.0",
    "@typespec/http": "^1.5.0",
    "@typespec/openapi": "^1.5.0",
    "@typespec/openapi3": "^1.5.0",
    "@typespec/rest": "^0.75.0",
    "concurrently": "^9.2.1",
    "swagger-ui-watcher": "^2.1.14"
  }
}
